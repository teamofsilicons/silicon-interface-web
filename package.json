{
  "name": "silicon-chat-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:staging-proxy": "node scripts/staging-api-proxy.mjs",
    "deploy:dry-run": "bash scripts/deploy-production.sh --dry-run",
    "deploy:production": "bash scripts/deploy-production.sh --confirm-production",
    "build": "next build --webpack",
    "test:deploy": "node --test tests/deploy/*.test.mjs",
    "test:reliability": "tsx --test tests/reliability/*.test.mjs",
    "security:audit": "node scripts/dependency-audit.mjs",
    "start": "next start",
    "lint": "eslint",
    "silicon-interface": "node ./packages/silicon-interface-cli/bin/silicon-interface.mjs",
    "si": "node ./packages/silicon-interface-cli/bin/silicon-interface.mjs",
    "desktop:build": "pnpm -C desktop build",
    "desktop:start": "pnpm -C desktop start",
    "desktop:test": "pnpm -C desktop test",
    "desktop:dist:win": "pnpm -C desktop dist:win",
    "desktop:dist:win:arm64": "pnpm -C desktop dist:win:arm64",
    "desktop:dist:linux": "pnpm -C desktop dist:linux",
    "desktop:dist:mac": "pnpm -C desktop dist:mac"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/noto-color-emoji": "5.2.12",
    "@fontsource/tiktok-sans": "5.2.4",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jdenticon": "^3.3.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "posthog-js": "^1.378.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "video.js": "^8.23.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@opentelemetry/core": "2.8.0",
      "brace-expansion": "5.0.8",
      "dompurify": "3.4.12",
      "fast-uri@3": "3.1.4",
      "form-data@4.0.5": "4.0.6",
      "js-yaml@4.1.1": "4.3.0",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "sharp": "0.35.3",
      "tar": "7.5.22",
      "undici@6.26.0": "6.27.0",
      "undici@7.27.2": "7.28.0"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch",
      "minimatch@5.1.9": "patches/minimatch@5.1.9.patch",
      "minimatch@9.0.9": "patches/minimatch@9.0.9.patch"
    }
  }
}
